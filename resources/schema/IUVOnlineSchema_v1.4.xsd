                    </xsd:simpleType>
                </xsd:element>
                <xsd:element name="codice_iuv">
                    <xsd:simpleType>
                        <xsd:restriction base="xsd:string">
                            <xsd:minLength value="1"></xsd:minLength>
                            <xsd:maxLength value="35"></xsd:maxLength>
                        </xsd:restriction>
                    </xsd:simpleType>
                </xsd:element>
