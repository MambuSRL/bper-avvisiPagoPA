    <xsd:complexType name="IUVOnlineCreateRequestData">
        <xsd:sequence>
            <xsd:element name="numero_disposizioni">
                <xsd:simpleType>
                    <xsd:restriction base="xsd:nonNegativeInteger">

                        <xsd:minInclusive value="1"/>

                        <xsd:maxInclusive value="24"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="informazioni_banca"
                         type="iuv:InformazioniBanca">
            </xsd:element>
            <xsd:element name="informazioni_debitore"
                         type="iuv:InformazioniDebitore">
            </xsd:element>
            <xsd:element name="informazioni_pagamento"
                         type="iuv:InformazioniPagamento" maxOccurs="24" minOccurs="1">
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="IUVOnlineUpdateRequestData">
        <xsd:sequence>
            <xsd:element name="informazioni_banca"
                         type="iuv:InformazioniBanca">
            </xsd:element>
            <xsd:element name="informazioni_debitore_modifica"
                         type="iuv:InformazioniDebitoreModifica">
            </xsd:element>
            <xsd:element name="informazioni_pagamento_modifica"
                         type="iuv:InformazioniPagamentoModifica">
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="IUVOnlineDeleteRequestData">
        <xsd:sequence>
            <xsd:element name="codice_identificativo_bollettino"
                         maxOccurs="1" minOccurs="1">
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:length value="18"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="getRTListRequestData">
        <xsd:sequence>
            <xsd:element name="stato"
                         maxOccurs="1" minOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Il chiamante può filtrare per lo stato delle RT che vuole ottenere
                    </xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:enumeration value="TUTTI"/>
                        <xsd:enumeration value="ESEGUITO"/>
                        <xsd:enumeration value="NON_ESEGUITO"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="numero_elementi_output"
                         maxOccurs="1" minOccurs="1">
                <xsd:annotation>
                    <xsd:documentation>Il chiamante deve indicare il numero massimo di RT da ottenere, serve per
                        contenere la response nel caso di grandi volumi
                    </xsd:documentation>
                </xsd:annotation>
                <xsd:simpleType>
                    <xsd:restriction base="xsd:nonNegativeInteger">
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="getRTReadRequestData">
        <xsd:sequence>
            <xsd:element name="Identificativo_RT"
                         type="iuv:Identificativo_RT">
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="sendAckRTUpdateRequestData">
        <xsd:sequence>
            <xsd:element name="Identificativo_RT"
                         type="iuv:Identificativo_RT">
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="getAvvisoPdfReadRequestData">
        <xsd:sequence>
            <xsd:element name="codice_identificativo_bollettino"
                         maxOccurs="1" minOccurs="1">
                <xsd:simpleType>
                    <xsd:restriction base="xsd:string">
                        <xsd:length value="18"/>
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="IUVOnlineDeleteResponseData">
        <xsd:sequence>
            <xsd:element name="timestamp_annullamento" type="xsd:dateTime">
            </xsd:element>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="getRTListResponseData">
        <xsd:sequence>
            <xsd:element name="totale_RT"
                         maxOccurs="1" minOccurs="1">
                <xsd:simpleType>
                    <xsd:restriction base="xsd:nonNegativeInteger">
                    </xsd:restriction>
                </xsd:simpleType>
            </xsd:element>
            <xsd:element name="listaRT" type="iuv:listaRT" minOccurs="0"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="getRTReadResponseData">
        <xsd:sequence>
            <xsd:element name="Identificativo_RT"
                         type="iuv:Identificativo_RT">
            </xsd:element>
            <xsd:element name="xml_RT" type="xsd:base64Binary"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="sendAckRTUpdateResponseData">
        <xsd:sequence>
            <xsd:element name="timestamp_ack" type="xsd:dateTime"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="getAvvisoPdfReadResponseData">
        <xsd:sequence>
            <xsd:element name="PDF_bollettino" type="xsd:base64Binary"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:complexType name="Testata">
        <xsd:sequence>
            <xsd:element name="id_transazione" type="xsd:string"/>
