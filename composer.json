{
    "name": "mambusrl/bper-avvisi-pagopa",
    "description": "Client PHP per il WS IUVOnline 1.4 di BPER Banca / BPS: generazione, variazione, annullo e recupero avvisi PagoPA, gestione ricevute telematiche (RT).",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": ["pagopa", "bper", "iuv", "avviso", "soap", "rt"],
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-libxml": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Mambu\\BperPagoPA\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mambu\\BperPagoPA\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
